                "textRuns": [
                  {
                    "value": "Data cleaning and caveats",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#0B2545"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Cholesterol = 0 in 53 rows and slope = 0 in 180 rows were recoded as missing and imputed inside the model pipeline.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. No duplicate rows or patient ids, so no patient is in both the training and the test set.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Population is Census 2011; facility layers date from about 2025. Predictions are experimental, not clinically validated.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              }
            ]
          }
        }
