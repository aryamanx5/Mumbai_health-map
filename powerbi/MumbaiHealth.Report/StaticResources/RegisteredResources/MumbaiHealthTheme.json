{
  "name": "Mumbai Health: heart risk and city care",
  "dataColors": [
    "#C8102E",
    "#0E7C86",
    "#0B2545",
    "#9FB7CF",
    "#E0A030",
    "#4DB6AC",
    "#8E5572",
    "#9AA5B1"
  ],
  "foreground": "#1B2A3A",
  "background": "#FFFFFF",
  "tableAccent": "#0B2545",
  "good": "#199E70",
  "neutral": "#F2B705",
  "bad": "#C0392B",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#1B2A3A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D5DEE7"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "fontSize": 12,
            "alignment": "center"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
