	partition clinical_patient = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "clinical_patient.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"patientid", Int64.Type}, {"split", type text}, {"age", Int64.Type}, {"age_band", type text}, {"age_band_order", Int64.Type}, {"sex", type text}, {"chest_pain", type text}, {"resting_bp", Int64.Type}, {"cholesterol", type number}, {"cholesterol_recorded", type text}, {"fasting_blood_sugar", type text}, {"resting_ecg", type text}, {"max_heart_rate", Int64.Type}, {"exercise_angina", type text}, {"st_depression", type number}, {"st_slope", type text}, {"major_vessels", Int64.Type}, {"target", Int64.Type}, {"outcome", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
