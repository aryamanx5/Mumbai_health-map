table clinical_patient
	lineageTag: a807ac2a-6561-5c7c-903c-f2ceddb13046

	measure Patients = COUNTROWS ( clinical_patient )
		formatString: #,0
		lineageTag: abd55b70-bdf4-5282-aa1a-b9e6a0a1a7c5

	measure 'Heart Disease Patients' = CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[target] = 1 )
		formatString: #,0
		lineageTag: 3af337c4-77e8-528f-abec-11a34f644d23

	measure 'Heart Disease Rate' = DIVIDE ( [Heart Disease Patients], [Patients] )
		formatString: 0.0%
		lineageTag: 0473a7d5-830d-5608-b6c3-68f1726cd0eb

	measure 'Average Age' = AVERAGE ( clinical_patient[age] )
		formatString: 0.0
		lineageTag: 357572e0-84d3-548f-92bd-9bd4a3bbc283

	measure 'Average Max Heart Rate' = AVERAGE ( clinical_patient[max_heart_rate] )
		formatString: 0
		lineageTag: a78aad26-1949-5a49-bc51-a54e6370bcc9

	measure 'Average Cholesterol' = AVERAGE ( clinical_patient[cholesterol] )
		formatString: 0
		lineageTag: 53cbe157-86fa-5060-b9dd-42bd24e39f5b

	measure 'Cholesterol Not Recorded' = CALCULATE ( COUNTROWS ( clinical_patient ), ISBLANK ( clinical_patient[cholesterol] ) )
		formatString: #,0
		lineageTag: fe17e094-9470-53c3-ad64-089a975d4331

	measure 'Male Share' = DIVIDE ( CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[sex] = "Male" ), [Patients] )
		formatString: 0.0%
		lineageTag: 2d545b83-bb05-5aa0-9717-4a3d33cc475b

	measure 'Majority Baseline Accuracy' = DIVIDE ( CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[split] = "Test", clinical_patient[target] = 1 ), CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[split] = "Test" ) )
		formatString: 0.000
		lineageTag: 4b2a22f1-5f04-55b8-b5d0-6c1e72e96f39

