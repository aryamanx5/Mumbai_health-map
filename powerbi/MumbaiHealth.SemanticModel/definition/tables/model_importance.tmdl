table model_importance
	lineageTag: 3271b13e-f205-5b9e-a9b3-8cd25fb1a41d

	measure 'Permutation Importance' = AVERAGE ( model_importance[importance] )
		formatString: 0.000
		lineageTag: bcfb7a69-c52f-5bb0-af3c-c7bae085f1a1

	column model
		dataType: string
		lineageTag: c02d3ff0-2b2f-5238-9883-ed0758aba7be
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column feature
		dataType: string
		lineageTag: 14942ad3-6994-5cbb-a1cd-2f08fb10e4f1
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = Automatic

	column importance
		dataType: double
		lineageTag: 44a33673-69a0-587d-aad0-1701162d39f1
		summarizeBy: none
		sourceColumn: importance

		annotation SummarizationSetBy = Automatic

	column importance_std
		dataType: double
		lineageTag: 1fe937f1-282e-59ea-b9e3-836edd30edd2
		summarizeBy: none
		sourceColumn: importance_std

		annotation SummarizationSetBy = Automatic

	partition model_importance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "model_importance.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"model", type text}, {"feature", type text}, {"importance", type number}, {"importance_std", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
