	partition fact_facility = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_facility.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"facility_id", type text}, {"site_id", type text}, {"ward_id", type text}, {"category", type text}, {"facility_name", type text}, {"address", type text}, {"source_subtype", type text}, {"longitude", type number}, {"latitude", type number}, {"coordinate_decimals", type number}, {"coordinate_status", type text}, {"assignment_check", type text}, {"source_file", type text}, {"source_record_id", Int64.Type}, {"category_label", type text}, {"coordinates_approximate", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
