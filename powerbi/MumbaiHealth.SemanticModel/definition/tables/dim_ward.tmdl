table dim_ward
	lineageTag: f380278c-e784-5bc3-8fa1-aa9a61742937

	measure 'Population 2011' = SUM ( dim_ward[population_2011] )
		formatString: #,0
		lineageTag: addbd257-4553-5294-8c8f-3a0495536e86

	measure 'Sites per 100k' = DIVIDE ( [Total Distinct Sites], [Population 2011] ) * 100000
		formatString: 0.00
		lineageTag: 317f0f0e-4f84-58f9-b742-0b5000d0ef86

	measure 'City-wide Sites per 100k' = CALCULATE ( [Sites per 100k], ALL ( dim_ward ) )
		formatString: 0.00
		lineageTag: a3837a67-a4d7-5d5d-aee2-1c3055bc75e0

	measure 'Population Share %' = DIVIDE ( [Population 2011], CALCULATE ( [Population 2011], ALL ( dim_ward ) ) ) * 100
		formatString: 0.00
		lineageTag: 46c0a1ba-0841-5a0a-acc4-b9072333770f

	measure 'Facility Share %' = DIVIDE ( [Total Distinct Sites], CALCULATE ( [Total Distinct Sites], ALL ( dim_ward ) ) ) * 100
		formatString: 0.00
		lineageTag: b8de977b-9e13-51fa-9ca0-b6b5ca33dc63

	measure 'Share Gap (pp)' = [Population Share %] - [Facility Share %]
		formatString: +0.00;-0.00;0.00
		lineageTag: 92598017-e62c-59d9-a575-9e6d345a9d88

