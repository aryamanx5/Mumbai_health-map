	partition dim_ward = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_ward.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ward_id", type text}, {"area_km2", type number}, {"population_2011", Int64.Type}, {"census_wards", Int64.Type}, {"census_district", type text}, {"ward_name", type text}, {"ward_order", Int64.Type}, {"population_density_per_km2", type number}, {"dispensary_count", Int64.Type}, {"uphc_count", Int64.Type}, {"public_hospital_count", Int64.Type}, {"maternity_hospital_count", Int64.Type}, {"total_distinct_public_facilities", Int64.Type}, {"total_facility_records", Int64.Type}, {"facilities_per_100k", type number}, {"population_per_facility", type number}, {"dispensary_per_100k", type number}, {"dispensary_share_pct", type number}, {"uphc_per_100k", type number}, {"uphc_share_pct", type number}, {"public_hospital_per_100k", type number}, {"public_hospital_share_pct", type number}, {"maternity_hospital_per_100k", type number}, {"maternity_hospital_share_pct", type number}, {"population_share_pct", type number}, {"facility_share_pct", type number}, {"population_facility_share_gap", type number}, {"cluster_label", Int64.Type}, {"cluster_name", type text}, {"cluster_k2_label", Int64.Type}, {"silhouette_sample", type number}, {"rank_sites_per_100k_low_to_high", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
