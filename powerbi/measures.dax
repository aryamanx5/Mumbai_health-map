// Measures in MumbaiHealth.SemanticModel, generated by src/powerbi_project.py.
// Each sits on the table named in its comment; the project already contains them.

// fact_facility   format: #,0
Total Distinct Sites = DISTINCTCOUNT ( fact_facility[site_id] )

// fact_facility   format: #,0
Facility Records = COUNTROWS ( fact_facility )

// dim_ward   format: #,0
Population 2011 = SUM ( dim_ward[population_2011] )

// dim_ward   format: 0.00
Sites per 100k = DIVIDE ( [Total Distinct Sites], [Population 2011] ) * 100000

// dim_ward   format: 0.00
City-wide Sites per 100k = CALCULATE ( [Sites per 100k], ALL ( dim_ward ) )

// dim_ward   format: 0.00
Population Share % = DIVIDE ( [Population 2011], CALCULATE ( [Population 2011], ALL ( dim_ward ) ) ) * 100

// dim_ward   format: 0.00
Facility Share % = DIVIDE ( [Total Distinct Sites], CALCULATE ( [Total Distinct Sites], ALL ( dim_ward ) ) ) * 100

// dim_ward   format: +0.00;-0.00;0.00
Share Gap (pp) = [Population Share %] - [Facility Share %]

// hospital_list   format: #,0
Hospitals Listed = COUNTROWS ( hospital_list )

// hospital_list   format: #,0
Beds Listed = SUM ( hospital_list[beds] )

// hospital_list   format: #,0
Public Hospitals Listed = CALCULATE ( COUNTROWS ( hospital_list ), hospital_list[ownership_class] = "Public" )

// clinical_patient   format: #,0
Patients = COUNTROWS ( clinical_patient )

// clinical_patient   format: #,0
Heart Disease Patients = CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[target] = 1 )

// clinical_patient   format: 0.0%
Heart Disease Rate = DIVIDE ( [Heart Disease Patients], [Patients] )

// clinical_patient   format: 0.0
Average Age = AVERAGE ( clinical_patient[age] )

// clinical_patient   format: 0
Average Max Heart Rate = AVERAGE ( clinical_patient[max_heart_rate] )

// clinical_patient   format: 0
Average Cholesterol = AVERAGE ( clinical_patient[cholesterol] )

// clinical_patient   format: #,0
Cholesterol Not Recorded = CALCULATE ( COUNTROWS ( clinical_patient ), ISBLANK ( clinical_patient[cholesterol] ) )

// clinical_patient   format: 0.0%
Male Share = DIVIDE ( CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[sex] = "Male" ), [Patients] )

// clinical_patient   format: 0.000
Majority Baseline Accuracy = DIVIDE ( CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[split] = "Test", clinical_patient[target] = 1 ), CALCULATE ( COUNTROWS ( clinical_patient ), clinical_patient[split] = "Test" ) )

// model_metric   format: 0.000
Test Metric = CALCULATE ( AVERAGE ( model_metric[value] ), model_metric[set] = "Test" )

// model_metric   format: 0.000
CV Metric = CALCULATE ( AVERAGE ( model_metric[value] ), model_metric[set] = "5-fold CV" )

// model_metric   format: 0.0%
Test Accuracy = CALCULATE ( [Test Metric], model_metric[metric] = "Accuracy" )

// model_metric   format: 0.000
Test ROC-AUC = CALCULATE ( [Test Metric], model_metric[metric] = "ROC-AUC" )

// model_metric   format: 0.000
Test F1 = CALCULATE ( [Test Metric], model_metric[metric] = "F1" )

// model_metric   format: 0.0%
Test Recall = CALCULATE ( [Test Metric], model_metric[metric] = "Recall" )

// model_metric   format: 0.000
Best Test ROC-AUC = CALCULATE ( MAX ( model_metric[value] ), model_metric[set] = "Test", model_metric[metric] = "ROC-AUC" )

// model_metric
Best Model = VAR scores = FILTER ( ALL ( model_metric ), model_metric[set] = "Test" && model_metric[metric] = "ROC-AUC" )
VAR top = MAXX ( scores, model_metric[value] )
RETURN MAXX ( FILTER ( scores, model_metric[value] = top ), model_metric[model] )

// model_confusion   format: #,0
Confusion Patients = SUM ( model_confusion[patients] )

// model_roc   format: 0.00
True Positive Rate = MAX ( model_roc[tpr] )

// model_importance   format: 0.000
Permutation Importance = AVERAGE ( model_importance[importance] )

// test_prediction   format: #,0
Test Predictions = COUNTROWS ( test_prediction )

// test_prediction   format: 0.0%
Correct Share = DIVIDE ( CALCULATE ( COUNTROWS ( test_prediction ), test_prediction[correct] = "Correct" ), COUNTROWS ( test_prediction ) )

// test_prediction   format: #,0
Patients All Models Right = CALCULATE (
    COUNTROWS (
        FILTER (
            VALUES ( test_prediction[patientid] ),
            CALCULATE ( COUNTROWS ( test_prediction ), test_prediction[correct] = "Correct" ) = 3
        )
    ),
    REMOVEFILTERS ( dim_model )
)

// missing_values   format: #,0
Missing Values = SUM ( missing_values[missing] )
