   <SimpleField name="Name_of_Mat_Home" type="string">
    <displayName>
     Name_of_Mat_Home
    </displayName>
   </SimpleField>
   <SimpleField name="OBJECTID" type="int">
    <displayName>
     OBJECTID
    </displayName>
   </SimpleField>
   <SimpleField name="Owner_Dept" type="string">
    <displayName>
     Owner_Dept
    </displayName>
   </SimpleField>
   <SimpleField name="Twitter_Handle" type="string">
    <displayName>
     Twitter_Handle
    </displayName>
   </SimpleField>
   <SimpleField name="Ward" type="string">
    <displayName>
     Ward
    </displayName>
   </SimpleField>
  </Schema>
  <Style id="mumbai_maternity_homes_style">
   <BalloonStyle>
    <text>
     &lt;table border="0"&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_maternity_homes/Address/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_maternity_homes/Address]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_maternity_homes/Name_of_Mat_Home/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_maternity_homes/Name_of_Mat_Home]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_maternity_homes/OBJECTID/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_maternity_homes/OBJECTID]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_maternity_homes/Owner_Dept/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_maternity_homes/Owner_Dept]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_maternity_homes/Twitter_Handle/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_maternity_homes/Twitter_Handle]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_maternity_homes/Ward/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_maternity_homes/Ward]&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
$[description]
    </text>
   </BalloonStyle>
  </Style>
