  <name>
   mumbai-dispensaries
  </name>
  <open>
   1
  </open>
  <Schema id="J_mumbai_dispensaries_SSIISSS" name="mumbai_dispensaries">
   <SimpleField name="Current_Na" type="string">
    <displayName>
     Current_Na
    </displayName>
   </SimpleField>
   <SimpleField name="Current_co" type="string">
    <displayName>
     Current_co
    </displayName>
   </SimpleField>
   <SimpleField name="OBJECTID" type="int">
    <displayName>
     OBJECTID
    </displayName>
   </SimpleField>
   <SimpleField name="OBJECTID_1" type="int">
    <displayName>
     OBJECTID_1
    </displayName>
   </SimpleField>
   <SimpleField name="Owner_Dept" type="string">
    <displayName>
     Owner_Dept
    </displayName>
   </SimpleField>
   <SimpleField name="Twitter_Handle" type="string">
    <displayName>
     Twitter_Handle
    </displayName>
   </SimpleField>
   <SimpleField name="Ward" type="string">
    <displayName>
     Ward
    </displayName>
   </SimpleField>
  </Schema>
  <Style id="mumbai_dispensaries_style">
   <BalloonStyle>
    <text>
     &lt;table border="0"&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/Current_Na/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/Current_Na]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/Current_co/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/Current_co]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/OBJECTID/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/OBJECTID]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/OBJECTID_1/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/OBJECTID_1]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/Owner_Dept/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/Owner_Dept]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/Twitter_Handle/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/Twitter_Handle]&lt;/td&gt;&lt;/tr&gt;
  &lt;tr&gt;&lt;td&gt;&lt;b&gt;$[mumbai_dispensaries/Ward/displayName]&lt;/b&gt;&lt;/td&gt;&lt;td&gt;$[mumbai_dispensaries/Ward]&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
$[description]
    </text>
   </BalloonStyle>
  </Style>
